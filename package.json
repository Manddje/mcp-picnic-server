{
  "name": "mop-picnic-server",
  "version": "1.1.0",
  "description": "Hosted, multi-user MCP server for the Picnic online supermarket. Add one URL to Claude or any other MCP client and sign in with your Picnic account.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manddje/mop-picnic-server.git"
  },
  "keywords": [
    "mcp",
    "picnic",
    "model-context-protocol",
    "claude",
    "supermarket"
  ],
  "author": "",
  "bugs": {
    "url": "https://github.com/Manddje/mop-picnic-server/issues"
  },
  "homepage": "https://github.com/Manddje/mop-picnic-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "picnic-api": "5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
