# Required. Encrypts every token. Generate with: openssl rand -hex 32
# Keep it the same across deploys: changing it signs every user out.
SECRET_KEY=

# Required. The public https address of this server, without a path.
PUBLIC_URL=https://picnic.example.com

# Number of reverse proxies in front of the server. Set it to exactly that number
# (usually 1); leave it out only when the server is reached directly.
TRUST_PROXY=1

# Optional. Comments go on their own line: docker --env-file reads the rest of a line as the value.
# PORT=3000
# SERVICE_NAME=Picnic MCP
# Email address or URL shown on the landing page:
# CONTACT=you@example.com
# Link to the source code shown on the landing page:
# SOURCE_URL=https://github.com/you/your-fork
# block (default) apps that aren't known ones, or warn: let them in with a warning:
# UNKNOWN_APPS=block
# More known apps: callback addresses, app schemes and host names:
# EXTRA_KNOWN_APPS=https://app.example.com/oauth/callback,myapp://
# Sign-ins that reach Picnic per minute, for the whole server:
# SIGN_IN_LIMIT_PER_MINUTE=60
# Requests of any kind that reach Picnic per minute, for the whole server:
# PICNIC_LIMIT_PER_MINUTE=300
# Requests one signed-in user may send to Picnic per minute, out of the above:
# PICNIC_USER_LIMIT_PER_MINUTE=120
# No requests to Picnic for this long after it throttled one; 0 for no pause:
# PICNIC_PAUSE_SECONDS=60
