# Required. Encrypts every token. Generate with: openssl rand -hex 32
# Keep it the same across deploys: changing it signs every user out.
SECRET_KEY=

# The public https address of this server, without a path.
# On Coolify you can leave this out: the domain you set for the app is used.
PUBLIC_URL=https://picnic.example.com

# Optional
# PORT=3000
# SERVICE_NAME=Picnic MCP
# CONTACT=you@example.com            # email address or URL shown on the landing page
# SOURCE_URL=https://github.com/...  # link to the source code shown on the landing page
# TRUST_PROXY=1                      # number of reverse proxies in front; default 1 on Coolify, otherwise off
# UNKNOWN_APPS=warn                  # warn (default) or block apps that aren't known ones
# EXTRA_KNOWN_APPS=app.example.com,myapp://   # more known apps: host names and app schemes
# SIGN_IN_LIMIT_PER_MINUTE=60        # sign-ins that reach Picnic per minute, for the whole server
